# Ticko API configuration
# ------------------------------------------------------------------
# Copy this file to `.env.local` if you need to override the defaults.
# Never commit real secrets. Agent-key credentials will be added in a
# later phase; public (read-only) endpoints need no authentication.
#
# The Ticko REST API base URL (Testnet). Public read endpoints such as
# `/market/symbols` do not require credentials.
TICKO_BASE_URL=https://api.testnet.ticko.xyz/v1

# ------------------------------------------------------------------
# Agent-key (signer) private key for signed ticko write endpoints.
# THIS IS A SECRET. Keep it in `.env.local` only (`.env*` is git-ignored).
# https://docs.ticko.xyz/api-documentation/authentication/signing
# Leave blank here; the real value is never committed and never logged.
TICKO_AGENT_PRIVATE_KEY=
# Account address the order operates on (target_address). Public.
TICKO_ACCOUNT_ADDRESS=
# Agent/API wallet address used as signer_address. Public.
TICKO_AGENT_ADDRESS=